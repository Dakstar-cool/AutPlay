{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/resource-admission/v1/error.schema.json",
  "title": "error",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "x-autplay-implementation-status": "ADAPTER_TESTED_ROLLOUT_PENDING"
}
