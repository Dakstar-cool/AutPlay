{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/resource-admission/v1/attachments-request.schema.json",
  "title": "attachments-request",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-autplay-integer-token-only": true,
      "const": 1
    },
    "activation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-autplay-integer-token-only": true
    },
    "expected_attachment_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-autplay-integer-token-only": true
    },
    "current_recording_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "next_recording_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "schema_version",
    "activation_id",
    "generation",
    "expected_attachment_revision",
    "current_recording_id",
    "next_recording_id"
  ],
  "additionalProperties": false,
  "x-autplay-implementation-status": "ADAPTER_TESTED_ROLLOUT_PENDING"
}
