{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/device-binding.schema.json",
  "title": "AutPlay Sync Device Binding v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "user_id",
    "device_id",
    "server_profile_id",
    "journal_epoch",
    "device_name",
    "platform",
    "app_version"
  ],
  "properties": {
    "protocol_version": {"type": "integer", "const": 1},
    "user_id": {"$ref": "#/$defs/uuid"},
    "device_id": {"$ref": "#/$defs/uuid"},
    "server_profile_id": {"$ref": "#/$defs/uuid"},
    "journal_epoch": {"$ref": "#/$defs/uuid"},
    "device_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "platform": {"enum": ["ANDROID", "WEB", "OTHER"]},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "supported_event_schema_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"}
  }
}
