{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/recommendation-feedback-recorded-payload.schema.json",
  "title": "AutPlay Recommendation Feedback Recorded Payload v1",
  "type": "object",
  "additionalProperties": {"$ref": "client-event.schema.json#/$defs/safeValue"},
  "propertyNames": {
    "allOf": [
      {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
      {
        "not": {
          "pattern": "(^|_)(access_token|refresh_token|token|authorization|password|credential|private_url|base_url|filesystem_path|absolute_path|raw_path|raw_search_query|search_query|raw_model_features|model_features|feature_vector|debug_text|personal_debug)(_|$)"
        }
      }
    ]
  },
  "required": ["interaction_type", "feedback_type", "recommendation"],
  "properties": {
    "interaction_type": {"const": "RECOMMENDATION_FEEDBACK_RECORDED"},
    "feedback_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "x-autplay-known-values": ["SELECTED", "DISMISSED"]
    },
    "recommendation": {
      "allOf": [
        {"$ref": "recommendation-attribution.schema.json"},
        {"required": ["impression_event_local_id"]}
      ]
    }
  }
}
