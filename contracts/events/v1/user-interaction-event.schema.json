{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/user-interaction-event.schema.json",
  "title": "AutPlay Canonical User Interaction Event v1",
  "description": "Known recommendation and listening events use this specialized full envelope. New event types continue to use the forward-compatible client-event envelope until their schema is published.",
  "allOf": [
    {"$ref": "client-event.schema.json"},
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {"const": "LISTENING_EVENT_RECORDED"},
            "aggregate_type": {"const": "LISTENING_EVENT"},
            "base_server_row_version": {"type": "null"},
            "payload": {"$ref": "listening-event-recorded-payload.schema.json"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "RECOMMENDATION_IMPRESSION_RECORDED"},
            "aggregate_type": {"const": "USER_INTERACTION_EVENT"},
            "base_server_row_version": {"type": "null"},
            "payload": {"$ref": "recommendation-impression-recorded-payload.schema.json"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "RECOMMENDATION_FEEDBACK_RECORDED"},
            "aggregate_type": {"const": "USER_INTERACTION_EVENT"},
            "base_server_row_version": {"type": "null"},
            "payload": {"$ref": "recommendation-feedback-recorded-payload.schema.json"}
          }
        }
      ]
    }
  ]
}
