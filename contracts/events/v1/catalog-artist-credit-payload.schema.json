{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/catalog-artist-credit-payload.schema.json",
  "title": "AutPlay Catalog Artist Credit Payload v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["artist_credit_id", "display_name", "names", "deleted_at"],
  "properties": {
    "artist_credit_id": {"$ref": "client-event.schema.json#/$defs/uuid"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 2000},
    "names": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["artist_id", "position", "credited_name", "join_phrase", "role"],
        "properties": {
          "artist_id": {"$ref": "client-event.schema.json#/$defs/uuid"},
          "position": {"type": "integer", "minimum": 0},
          "credited_name": {"type": "string", "minLength": 1, "maxLength": 1000},
          "join_phrase": {"type": "string", "maxLength": 1000},
          "role": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "deleted_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  }
}
