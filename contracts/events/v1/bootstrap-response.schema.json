{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/bootstrap-response.schema.json",
  "title": "AutPlay Sync Bootstrap Response v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "device_id",
    "server_profile_id",
    "journal_epoch",
    "snapshot_id",
    "snapshot_high_water_server_sequence",
    "aggregates",
    "tombstones",
    "redirects",
    "next_page_token",
    "has_more",
    "snapshot_cursor",
    "pending_event_directive",
    "server_time"
  ],
  "properties": {
    "protocol_version": {"type": "integer", "const": 1},
    "device_id": {"$ref": "#/$defs/uuid"},
    "server_profile_id": {"$ref": "#/$defs/uuid"},
    "journal_epoch": {"$ref": "#/$defs/uuid"},
    "snapshot_id": {"$ref": "#/$defs/uuid"},
    "snapshot_high_water_server_sequence": {"type": "integer", "minimum": 0},
    "aggregates": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/aggregate"}},
    "tombstones": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/tombstone"}},
    "redirects": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/redirect"}},
    "next_page_token": {"anyOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
    "has_more": {"type": "boolean"},
    "snapshot_cursor": {"anyOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
    "pending_event_directive": {"const": "PRESERVE_REBASE_RETRY"},
    "server_time": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "token": {"type": "string", "minLength": 16, "maxLength": 2048},
    "aggregate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["aggregate_type", "aggregate_server_id", "server_row_version", "payload"],
      "properties": {
        "aggregate_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "aggregate_server_id": {"$ref": "#/$defs/uuid"},
        "server_row_version": {"type": "integer", "minimum": 1},
        "payload": {"$ref": "#/$defs/safeObject"}
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tombstone_id",
        "aggregate_type",
        "aggregate_server_id",
        "deleted_by_event_id",
        "deleted_at",
        "retain_until"
      ],
      "properties": {
        "tombstone_id": {"$ref": "#/$defs/uuid"},
        "aggregate_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "aggregate_server_id": {"$ref": "#/$defs/uuid"},
        "deleted_by_event_id": {"$ref": "#/$defs/uuid"},
        "deleted_at": {"type": "string", "format": "date-time"},
        "retain_until": {"type": "string", "format": "date-time"}
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": true,
      "required": ["aggregate_type", "alias_server_id", "canonical_server_id"],
      "properties": {
        "aggregate_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "alias_server_id": {"$ref": "#/$defs/uuid"},
        "canonical_server_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "safeObject": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
          {
            "not": {
              "pattern": "(^|_)(access_token|refresh_token|token|authorization|password|credential|private_url|base_url|filesystem_path|absolute_path|raw_path|raw_search_query|search_query|raw_model_features|model_features|feature_vector|debug_text|personal_debug)(_|$)"
            }
          }
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "safeValue": {
      "anyOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"$ref": "#/$defs/safeObject"}
      ]
    }
  }
}
