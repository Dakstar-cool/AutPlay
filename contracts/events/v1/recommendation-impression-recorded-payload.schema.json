{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/recommendation-impression-recorded-payload.schema.json",
  "title": "AutPlay Recommendation Impression Recorded Payload v1",
  "type": "object",
  "additionalProperties": {"$ref": "client-event.schema.json#/$defs/safeValue"},
  "propertyNames": {
    "allOf": [
      {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
      {
        "not": {
          "pattern": "(^|_)(access_token|refresh_token|token|authorization|password|credential|private_url|base_url|filesystem_path|absolute_path|raw_path|raw_search_query|search_query|raw_model_features|model_features|feature_vector|debug_text|personal_debug)(_|$)"
        }
      }
    ]
  },
  "required": ["interaction_type", "recommendation"],
  "properties": {
    "interaction_type": {"const": "RECOMMENDATION_IMPRESSION_RECORDED"},
    "recommendation": {
      "allOf": [
        {"$ref": "recommendation-attribution.schema.json"},
        {"required": ["presentation_id", "display_position"]}
      ]
    }
  }
}
