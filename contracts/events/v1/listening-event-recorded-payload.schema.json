{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/listening-event-recorded-payload.schema.json",
  "title": "AutPlay Listening Event Recorded Payload v1",
  "type": "object",
  "additionalProperties": {"$ref": "client-event.schema.json#/$defs/safeValue"},
  "propertyNames": {
    "allOf": [
      {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
      {
        "not": {
          "pattern": "(^|_)(access_token|refresh_token|token|authorization|password|credential|private_url|base_url|filesystem_path|absolute_path|raw_path|raw_search_query|search_query|raw_model_features|model_features|feature_vector|debug_text|personal_debug)(_|$)"
        }
      }
    ]
  },
  "required": ["interaction_type", "local_user_track_ref_id", "server_user_track_ref_id", "recording_id", "played_ms", "track_duration_ms", "completion_ratio", "event_origin", "context", "explicit_feedback", "excluded_from_taste", "recommendation"],
  "properties": {
    "interaction_type": {"const": "LISTENING_EVENT_RECORDED"},
    "local_user_track_ref_id": {"$ref": "client-event.schema.json#/$defs/uuid"},
    "server_user_track_ref_id": {"anyOf": [{"$ref": "client-event.schema.json#/$defs/uuid"}, {"type": "null"}]},
    "recording_id": {"anyOf": [{"$ref": "client-event.schema.json#/$defs/uuid"}, {"type": "null"}]},
    "played_ms": {"type": "integer", "minimum": 0, "maximum": 604800000},
    "track_duration_ms": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 604800000}, {"type": "null"}]},
    "completion_ratio": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
    "event_origin": {"anyOf": [{"enum": ["ORGANIC", "RECOMMENDED", "PLAYLIST", "SEARCH", "WAVE"]}, {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Z][A-Z0-9_]{0,99}$"}], "x-autplay-known-values": ["ORGANIC", "RECOMMENDED", "PLAYLIST", "SEARCH", "WAVE"]},
    "context": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Z][A-Z0-9_]{0,49}$", "x-autplay-known-values": ["GENERAL", "WORKOUT", "CYCLING", "WORK", "SLEEP", "PARTY"]},
    "explicit_feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Z][A-Z0-9_]{0,49}$",
      "x-autplay-known-values": ["NONE", "LIKE", "DISLIKE"]
    },
    "excluded_from_taste": {"type": "boolean"},
    "recommendation": {"anyOf": [{"$ref": "recommendation-attribution.schema.json"}, {"type": "null"}]}
  },
  "allOf": [{"if": {"properties": {"event_origin": {"const": "RECOMMENDED"}}}, "then": {"properties": {"recommendation": {"$ref": "recommendation-attribution.schema.json"}}}}]
}
