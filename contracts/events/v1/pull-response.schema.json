{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/events/v1/pull-response.schema.json",
  "title": "AutPlay Sync Pull Response v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "device_id",
    "server_profile_id",
    "journal_epoch",
    "from_cursor",
    "next_cursor",
    "has_more",
    "events",
    "server_time"
  ],
  "properties": {
    "protocol_version": {"type": "integer", "const": 1},
    "device_id": {"$ref": "#/$defs/uuid"},
    "server_profile_id": {"$ref": "#/$defs/uuid"},
    "journal_epoch": {"$ref": "#/$defs/uuid"},
    "from_cursor": {"$ref": "#/$defs/nullableCursor"},
    "next_cursor": {"$ref": "#/$defs/cursor"},
    "has_more": {"type": "boolean"},
    "events": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/serverEvent"}},
    "server_time": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "cursor": {"type": "string", "minLength": 16, "maxLength": 2048},
    "nullableCursor": {
      "anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]
    },
    "serverEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "server_sequence",
        "event_id",
        "origin_device_id",
        "event_type",
        "schema_version",
        "aggregate_type",
        "aggregate_server_id",
        "server_row_version",
        "operation",
        "payload",
        "created_at"
      ],
      "properties": {
        "server_sequence": {"type": "integer", "minimum": 1},
        "event_id": {"$ref": "#/$defs/uuid"},
        "origin_device_id": {
          "anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
        },
        "event_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "schema_version": {"type": "integer", "minimum": 1},
        "aggregate_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "aggregate_server_id": {"$ref": "#/$defs/uuid"},
        "server_row_version": {
          "anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "operation": {"enum": ["UPSERT", "DELETE", "REDIRECT"]},
        "payload": {"$ref": "#/$defs/safeObject"},
        "created_at": {"type": "string", "format": "date-time"},
        "tombstone": {"$ref": "#/$defs/tombstone"},
        "redirect": {"$ref": "#/$defs/redirect"}
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tombstone_id", "deleted_by_event_id", "deleted_at", "retain_until"],
      "properties": {
        "tombstone_id": {"$ref": "#/$defs/uuid"},
        "deleted_by_event_id": {"$ref": "#/$defs/uuid"},
        "deleted_at": {"type": "string", "format": "date-time"},
        "retain_until": {"type": "string", "format": "date-time"}
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": true,
      "required": ["alias_server_id", "canonical_server_id"],
      "properties": {
        "alias_server_id": {"$ref": "#/$defs/uuid"},
        "canonical_server_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "safeObject": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
          {
            "not": {
              "pattern": "(^|_)(access_token|refresh_token|token|authorization|password|credential|private_url|base_url|filesystem_path|absolute_path|raw_path|raw_search_query|search_query|raw_model_features|model_features|feature_vector|debug_text|personal_debug)(_|$)"
            }
          }
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "safeValue": {
      "oneOf": [
        {"$ref": "#/$defs/safeObject"},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": ["string", "number", "boolean", "null"]}
      ]
    }
  }
}
