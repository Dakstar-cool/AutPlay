{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/social/v1/guest-invitation-create.schema.json",
  "title": "S1D host-issued guest Room document command",
  "x-autplay-implementation-status": "IMPLEMENTED_S1D",
  "x-autplay-secret-transport": "NO_STORE_POST_BODY_ONLY_HASH_ONLY_PERSISTENCE",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "room_id", "document_bearer", "ttl_seconds", "max_uses"],
  "properties": {
    "operation_id": {"type": "string", "format": "uuid"},
    "room_id": {"type": "string", "format": "uuid"},
    "document_bearer": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 21600, "default": 900},
    "max_uses": {"type": "integer", "minimum": 1, "maximum": 8, "default": 1}
  }
}
