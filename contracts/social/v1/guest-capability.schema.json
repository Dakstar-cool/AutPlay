{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/social/v1/guest-capability.schema.json",
  "title": "S1D exact-Room guest capability view",
  "x-autplay-implementation-status": "IMPLEMENTED_S1D",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "guest_session_id", "invitation_id", "room_id", "room_epoch", "role", "allowed_actions", "display_name", "expires_at", "media_boundary"],
  "properties": {
    "operation_id": {"type": "string", "format": "uuid"},
    "guest_session_id": {"type": "string", "format": "uuid"},
    "invitation_id": {"type": "string", "format": "uuid"},
    "room_id": {"type": "string", "format": "uuid"},
    "room_epoch": {"type": "integer", "minimum": 1},
    "role": {"const": "GUEST"},
    "allowed_actions": {"const": ["ROOM_SNAPSHOT", "ROOM_EVENTS", "ROOM_PRESENCE", "ROOM_PREFLIGHT", "ROOM_TIMING", "ROOM_LEAVE"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 40},
    "expires_at": {"type": "string", "format": "date-time"},
    "media_boundary": {"const": "INDEPENDENT_DEVICE_AUTHORIZATION_ONLY"}
  }
}
