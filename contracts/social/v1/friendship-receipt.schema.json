{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/social/v1/friendship-receipt.schema.json",
  "title": "S1C durable friendship command receipt",
  "x-autplay-implementation-status": "IMPLEMENTED_S1C",
  "type": "object", "additionalProperties": false,
  "required": ["operation_id", "state"],
  "properties": {
    "operation_id": {"type": "string", "format": "uuid"},
    "state": {"enum": ["PENDING_OUTGOING", "PENDING_INCOMING", "MUTUAL", "DECLINED", "CANCELLED", "REMOVED", "BLOCKED", "UNBLOCKED"]}
  }
}
