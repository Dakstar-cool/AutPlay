{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/face/v1/timeline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "track_character",
    "keyframes",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity": {
      "$ref": "timeline-identity.schema.json"
    },
    "track_character": {
      "$ref": "semantic-state.schema.json"
    },
    "keyframes": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_ms",
          "state"
        ],
        "properties": {
          "time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "state": {
            "$ref": "semantic-state.schema.json"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_ms",
          "event_type",
          "strength",
          "confidence"
        ],
        "properties": {
          "time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
