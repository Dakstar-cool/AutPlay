{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/face/v1/timeline-identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recording_id",
    "audio_variant_id",
    "source_sha256",
    "source_duration_ms",
    "source_timebase",
    "embedding_model_id",
    "embedding_manifest_sha256",
    "semantic_interpreter_id",
    "interpreter_manifest_sha256",
    "preprocessing_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recording_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "audio_variant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "source_timebase": {
      "const": "SOURCE_MILLISECONDS_V1"
    },
    "embedding_model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "embedding_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_interpreter_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "interpreter_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preprocessing_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
