{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/face/v1/semantic-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axes"
  ],
  "properties": {
    "axes": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "confidence",
              "abstained",
              "reason_code"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "abstained": {
                "const": false
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "confidence",
              "abstained",
              "reason_code"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "confidence": {
                "type": "null"
              },
              "abstained": {
                "const": true
              },
              "reason_code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              }
            }
          }
        ]
      }
    }
  }
}
