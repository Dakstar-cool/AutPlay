{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/face/v2/source-presentation-map.schema.json",
  "title": "SourcePresentationMapV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "encoded_source_sha256", "decoded_sample_rate",
    "decoded_sample_count", "decoder_id", "decoder_version", "probe_id", "probe_version",
    "leading_trim_samples", "trailing_trim_samples", "encoder_delay_samples",
    "encoder_padding_samples", "segments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "SOURCE_PRESENTATION_MAP_V1"},
    "encoded_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decoded_sample_rate": {"type": "integer", "minimum": 8000, "maximum": 384000},
    "decoded_sample_count": {"type": "integer", "minimum": 1, "maximum": 33177600000},
    "decoder_id": {"$ref": "#/$defs/identity"},
    "decoder_version": {"$ref": "#/$defs/identity"},
    "probe_id": {"$ref": "#/$defs/identity"},
    "probe_version": {"$ref": "#/$defs/identity"},
    "leading_trim_samples": {"type": "integer", "minimum": 0},
    "trailing_trim_samples": {"type": "integer", "minimum": 0},
    "encoder_delay_samples": {"type": ["integer", "null"], "minimum": 0},
    "encoder_padding_samples": {"type": ["integer", "null"], "minimum": 0},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["presentation_start_us", "presentation_end_us", "source_start_sample"],
        "properties": {
          "presentation_start_us": {"type": "integer", "minimum": 0, "maximum": 86400000000},
          "presentation_end_us": {"type": "integer", "minimum": 1, "maximum": 86400000000},
          "source_start_sample": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
  }
}
