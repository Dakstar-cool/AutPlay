{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/face/v2/projection-tombstone.schema.json",
  "title": "FaceProjectionTombstoneV2 sync payload",
  "x-autplay-implementation-status": "CONTRACT_ONLY_DISABLED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_id", "server_profile_id", "user_id",
    "superseding_generation", "reason_code", "tombstoned_at_ms"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "projection_id": {"$ref": "#/$defs/uuid"},
    "server_profile_id": {"$ref": "#/$defs/uuid"},
    "user_id": {"$ref": "#/$defs/uuid"},
    "superseding_generation": {
      "type": "integer", "minimum": 1, "maximum": 9007199254740991
    },
    "reason_code": {
      "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
    },
    "tombstoned_at_ms": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740991
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
