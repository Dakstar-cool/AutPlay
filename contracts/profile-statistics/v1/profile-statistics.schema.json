{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/profile-statistics/v1/profile-statistics.schema.json",
  "title": "S2 friend-visible completed-day profile statistics",
  "x-autplay-implementation-status": "IMPLEMENTED_S2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "through_utc_date", "windows"],
  "properties": {
    "schema_version": {"const": 1},
    "through_utc_date": {"type": "string", "format": "date"},
    "windows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/last7"},
        {"$ref": "#/$defs/last30"},
        {"$ref": "#/$defs/last365"}
      ],
      "items": false
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "play_session_count", "listened_ms", "unique_track_count"],
      "properties": {
        "window": {"type": "string"},
        "play_session_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "listened_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "unique_track_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "last7": {"allOf": [{"$ref": "#/$defs/counts"}, {"properties": {"window": {"const": "LAST_7_COMPLETE_DAYS"}}}]},
    "last30": {"allOf": [{"$ref": "#/$defs/counts"}, {"properties": {"window": {"const": "LAST_30_COMPLETE_DAYS"}}}]},
    "last365": {"allOf": [{"$ref": "#/$defs/counts"}, {"properties": {"window": {"const": "LAST_365_COMPLETE_DAYS"}}}]}
  }
}
