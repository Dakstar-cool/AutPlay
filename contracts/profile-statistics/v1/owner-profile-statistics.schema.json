{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated owner account statistics",
  "description": "Private authenticated account totals across all devices. Portable listening aliases count once per logical record; future events are excluded. Genres include portable and owner metadata. No device, session or Vault authority is returned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "account_id", "through_ms", "listened_ms", "top_genres", "top_tracks", "top_artists"],
  "properties": {
    "schema_version": {"const": 1},
    "account_id": {"type": "string", "format": "uuid"},
    "through_ms": {"type": "integer", "minimum": 0},
    "listened_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "top_genres": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/genre"}},
    "top_tracks": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/track"}},
    "top_artists": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/artist"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "maxLength": 2000},
    "genre": {"type": "object", "additionalProperties": false, "required": ["genre", "listened_ms"], "properties": {
      "genre": {"type": "string", "minLength": 1, "maxLength": 100}, "listened_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
    }},
    "track": {"type": "object", "additionalProperties": false, "required": ["identity_key", "title", "artist_name", "play_session_count", "listened_ms"], "properties": {
      "identity_key": {"type": "string", "format": "uuid"}, "title": {"$ref": "#/$defs/nullableText"}, "artist_name": {"$ref": "#/$defs/nullableText"},
      "play_session_count": {"type": "integer", "minimum": 0}, "listened_ms": {"type": "integer", "minimum": 0}
    }},
    "artist": {"type": "object", "additionalProperties": false, "required": ["artist_name", "play_session_count", "listened_ms"], "properties": {
      "artist_name": {"$ref": "#/$defs/nullableText"}, "play_session_count": {"type": "integer", "minimum": 0}, "listened_ms": {"type": "integer", "minimum": 0}
    }}
  }
}
