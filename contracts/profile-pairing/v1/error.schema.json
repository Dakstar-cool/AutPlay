{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/profile-pairing/v1/error.schema.json",
  "title": "ProfilePairingError",
  "type": "object",
  "required": ["contract_version", "schema_version", "error_code", "safe_message", "request_id", "retryable"],
  "properties": {
    "contract_version": {"const": "v1"},
    "schema_version": {"const": 1},
    "error_code": {"enum": ["not_connected", "server_unavailable", "transport_trust_required", "server_identity_changed", "incompatible_api_major", "capability_missing", "capability_rollback_detected", "enrollment_invitation_unavailable", "enrollment_rate_limited", "stale_flow_generation", "auth_attention_required", "device_revoked", "session_revoked", "remote_outcome_unknown", "materialization_binding_changed", "unauthorized"]},
    "safe_message": {"type": "string", "minLength": 1, "maxLength": 240},
    "request_id": {"type": "string", "format": "uuid"},
    "retryable": {"type": "boolean"},
    "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "additionalProperties": false,
  "x-autplay-implementation-status": "DRAFT_NOT_IMPLEMENTED"
}
