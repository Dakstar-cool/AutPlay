{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/profile-pairing/v1/discovery-metadata.schema.json",
  "title": "DiscoveryMetadata",
  "type": "object",
  "required": ["contract_version", "schema_version", "payload", "payload_sha256", "signature_algorithm", "signature_b64url"],
  "properties": {
    "contract_version": {"const": "v1"},
    "schema_version": {"const": 1},
    "payload": {
      "type": "object",
      "required": ["server_instance_id", "identity_epoch", "identity_public_key_spki_b64", "identity_thumbprint_sha256", "label_hint", "api_origin", "stream_origin", "supported_api_majors", "enrollment_protocol_available", "issued_at", "expires_at"],
      "properties": {
        "server_instance_id": {"type": "string", "format": "uuid"},
        "identity_epoch": {"type": "integer", "minimum": 1},
        "identity_public_key_spki_b64": {"type": "string", "minLength": 32, "maxLength": 256},
        "identity_thumbprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "label_hint": {"type": "string", "minLength": 1, "maxLength": 80},
        "api_origin": {"type": "string", "format": "uri", "maxLength": 2048},
        "stream_origin": {"type": "string", "format": "uri", "maxLength": 2048},
        "supported_api_majors": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 255}},
        "enrollment_protocol_available": {"type": "boolean"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_algorithm": {"const": "ES256-P1363"},
    "signature_b64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "additionalProperties": false,
  "x-autplay-implementation-status": "DRAFT_NOT_IMPLEMENTED",
  "x-autplay-max-canonical-bytes": 16384
}
