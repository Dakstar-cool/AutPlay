{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/discovery/v1/discovery-command.schema.json",
  "title": "Owner-derived discovery command v1",
  "type": "object",
  "additionalProperties": false,
  "x-autplay-implementation-status": "CONTRACT_ACCEPTED_RUNTIME_NOT_IMPLEMENTED",
  "required": ["contract_version", "schema_version", "operation_id", "action"],
  "properties": {
    "contract_version": {"const": "release-discovery-v1"},
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "format": "uuid"},
    "action": {
      "enum": [
        "START_DISCOVERY",
        "RETRY_DISCOVERY",
        "SELECT_CANDIDATE",
        "IGNORE_CANDIDATE",
        "SET_ARTIST_POLICY"
      ]
    },
    "canonical_artist_id": {"type": "string", "format": "uuid"},
    "artist_scope": {"enum": ["SELECTED", "ALL_ELIGIBLE_BOUNDED"]},
    "canonical_artist_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "run_id": {"type": "string", "format": "uuid"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "discovery_mode": {"enum": ["DISABLED", "MANUAL_ONLY", "SCHEDULED"]},
    "import_mode": {"enum": ["REVIEW_REQUIRED", "AUTO_IMPORT"]},
    "expected_policy_revision": {"type": "integer", "minimum": 1},
    "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "consequence_confirmation": {"type": "string", "maxLength": 128}
  },
  "oneOf": [
    {
      "properties": {"action": {"const": "START_DISCOVERY"}},
      "required": ["artist_scope"],
      "not": {
        "anyOf": [
          {"required": ["canonical_artist_id"]},
          {"required": ["run_id"]},
          {"required": ["candidate_id"]},
          {"required": ["discovery_mode"]},
          {"required": ["import_mode"]},
          {"required": ["expected_policy_revision"]},
          {"required": ["reason_code"]},
          {"required": ["consequence_confirmation"]}
        ]
      },
      "allOf": [
        {
          "if": {"properties": {"artist_scope": {"const": "SELECTED"}}},
          "then": {"required": ["canonical_artist_ids"]}
        },
        {
          "if": {"properties": {"artist_scope": {"const": "ALL_ELIGIBLE_BOUNDED"}}},
          "then": {"not": {"required": ["canonical_artist_ids"]}}
        }
      ]
    },
    {
      "properties": {"action": {"const": "RETRY_DISCOVERY"}},
      "required": ["run_id"],
      "not": {
        "anyOf": [
          {"required": ["canonical_artist_id"]},
          {"required": ["artist_scope"]},
          {"required": ["canonical_artist_ids"]},
          {"required": ["candidate_id"]},
          {"required": ["discovery_mode"]},
          {"required": ["import_mode"]},
          {"required": ["expected_policy_revision"]},
          {"required": ["reason_code"]},
          {"required": ["consequence_confirmation"]}
        ]
      }
    },
    {
      "properties": {"action": {"const": "SELECT_CANDIDATE"}},
      "required": ["candidate_id"],
      "not": {
        "anyOf": [
          {"required": ["canonical_artist_id"]},
          {"required": ["artist_scope"]},
          {"required": ["canonical_artist_ids"]},
          {"required": ["run_id"]},
          {"required": ["discovery_mode"]},
          {"required": ["import_mode"]},
          {"required": ["expected_policy_revision"]},
          {"required": ["reason_code"]},
          {"required": ["consequence_confirmation"]}
        ]
      }
    },
    {
      "properties": {"action": {"const": "IGNORE_CANDIDATE"}},
      "required": ["candidate_id"],
      "not": {
        "anyOf": [
          {"required": ["canonical_artist_id"]},
          {"required": ["artist_scope"]},
          {"required": ["canonical_artist_ids"]},
          {"required": ["run_id"]},
          {"required": ["discovery_mode"]},
          {"required": ["import_mode"]},
          {"required": ["expected_policy_revision"]},
          {"required": ["consequence_confirmation"]}
        ]
      }
    },
    {
      "properties": {"action": {"const": "SET_ARTIST_POLICY"}},
      "required": [
        "canonical_artist_id",
        "discovery_mode",
        "import_mode",
        "expected_policy_revision"
      ],
      "not": {
        "anyOf": [
          {"required": ["artist_scope"]},
          {"required": ["canonical_artist_ids"]},
          {"required": ["run_id"]},
          {"required": ["candidate_id"]},
          {"required": ["reason_code"]}
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"import_mode": {"const": "AUTO_IMPORT"}}, "required": ["import_mode"]},
      "then": {"required": ["consequence_confirmation"]}
    }
  ]
}
