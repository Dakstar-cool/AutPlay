{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/discovery/v1/automation-mobile-candidates.schema.json",
  "title": "A1C Android run candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "schema_version", "run_id", "candidates"],
  "properties": {
    "contract_version": {"const": "release-discovery-v1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "run_id", "title", "artist", "album", "released_at", "disposition", "acquisition_state", "selected_automatically"],
        "properties": {
          "candidate_id": {"type": "string", "format": "uuid"},
          "run_id": {"type": "string", "format": "uuid"},
          "title": {"type": "string", "minLength": 1, "maxLength": 4096},
          "artist": {"type": "string", "minLength": 1, "maxLength": 4096},
          "album": {"type": ["string", "null"], "maxLength": 4096},
          "released_at": {"type": ["string", "null"], "format": "date-time"},
          "disposition": {"type": "string", "minLength": 1, "maxLength": 64},
          "acquisition_state": {"type": "string", "minLength": 1, "maxLength": 64},
          "selected_automatically": {"type": "boolean"}
        }
      }
    }
  },
  "x-autplay-implementation-status": "IMPLEMENTED_POST_A1C_ANDROID"
}
