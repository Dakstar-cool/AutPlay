              "null"
            ],
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "UNKNOWN"
                }
              }
            },
            "then": {
              "properties": {
                "revision": {
                  "const": 0
                },
                "changed_at": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "revision": {
                  "minimum": 1
                },
                "changed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "revision": {
                  "const": 9007199254740991
                }
              }
            },
            "then": {
              "properties": {
