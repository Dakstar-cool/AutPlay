{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/public-access/v1/account-registration-request.schema.json",
  "title": "AccountRegistrationRequest",
  "type": "object",
  "required": ["contract_version", "schema_version", "registration_id", "binding_commit_id", "invitation_id", "invitation_secret", "expected_server_instance_id", "expected_identity_epoch", "expected_identity_thumbprint_sha256", "expected_api_origin", "expected_stream_origin", "expected_account_display_name", "device_name", "platform", "app_version", "device_public_key_spki_b64", "device_key_thumbprint_sha256", "next_refresh_token_sha256", "client_nonce_b64url", "request_sha256", "signature_algorithm", "device_signature_b64url"],
  "properties": {
    "contract_version": {"const": "v1"},
    "schema_version": {"const": 1},
    "registration_id": {"type": "string", "format": "uuid"},
    "binding_commit_id": {"type": "string", "format": "uuid"},
    "invitation_id": {"type": "string", "format": "uuid"},
    "invitation_secret": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "expected_server_instance_id": {"type": "string", "format": "uuid"},
    "expected_identity_epoch": {"type": "integer", "minimum": 1},
    "expected_identity_thumbprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_api_origin": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "expected_stream_origin": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "expected_account_display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "device_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "platform": {"const": "ANDROID"},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "device_public_key_spki_b64": {"type": "string", "minLength": 32, "maxLength": 256},
    "device_key_thumbprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "next_refresh_token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "client_nonce_b64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_algorithm": {"const": "ES256-P1363"},
    "device_signature_b64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "additionalProperties": false,
  "x-autplay-sensitive": true,
  "x-autplay-proof-domain": "AutPlay account registration v1\n",
  "x-autplay-implementation-status": "IMPLEMENTED_PA2"
}
