{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/ml/v1/artifact-license-review-command.schema.json",
  "title": "ML artifact license review command v1",
  "x-autplay-implementation-status": "CONTRACT_ONLY_DISABLED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_generation",
    "artifact_sha256",
    "state",
    "license_identifier",
    "license_text_sha256",
    "use_restrictions",
    "redistribution_decision",
    "modification_decision",
    "attribution_payload",
    "review_reference",
    "reason_code",
    "max_offline_revocation_lag_ms",
    "derived_output_disposition"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": ["APPROVED", "DENIED", "REVOKED"]
    },
    "license_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "license_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "use_restrictions": {
      "type": "object",
      "description": "Canonical JSON and PostgreSQL text must each fit 8192 UTF-8 bytes."
    },
    "redistribution_decision": {
      "enum": ["PERMITTED", "DENIED", "SEPARATE_INSTALL_ONLY"]
    },
    "modification_decision": {
      "enum": ["PERMITTED", "DENIED", "UNREVIEWED"]
    },
    "attribution_payload": {
      "type": "object",
      "description": "Canonical JSON and PostgreSQL text must each fit 8192 UTF-8 bytes."
    },
    "review_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
    },
    "max_offline_revocation_lag_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "derived_output_disposition": {
      "enum": ["DELETE_AFTER_LEASE", "RETAIN_NON_DISTRIBUTABLE"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "APPROVED"}},
        "required": ["state"]
      },
      "then": {
        "properties": {"max_offline_revocation_lag_ms": {"minimum": 1}}
      },
      "else": {
        "properties": {"max_offline_revocation_lag_ms": {"const": 0}}
      }
    }
  ]
}
