{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/ml/v1/sona-cohort-operation-command.schema.json",
  "title": "Disabled Sona R1C owner-cohort administrative command",
  "x-autplay-implementation-status": "CONTRACT_ONLY_DISABLED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id", "action", "expected_activation_epoch",
    "expected_cohort_generation", "expected_breaker_generation",
    "reason_code", "step_up_challenge_id"
  ],
  "properties": {
    "operation_id": {"$ref": "#/$defs/uuid"},
    "action": {
      "enum": ["ADD_RECIPIENT", "REMOVE_RECIPIENT", "KILL_COHORT", "ENTER_HALF_OPEN"]
    },
    "expected_activation_epoch": {"$ref": "#/$defs/positive_generation"},
    "expected_cohort_generation": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740990
    },
    "expected_breaker_generation": {
      "oneOf": [{"$ref": "#/$defs/positive_generation"}, {"type": "null"}]
    },
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"},
    "step_up_challenge_id": {"$ref": "#/$defs/uuid"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "ENTER_HALF_OPEN"}}},
      "then": {"properties": {"expected_breaker_generation": {"$ref": "#/$defs/positive_generation"}}},
      "else": {"properties": {"expected_breaker_generation": {"type": "null"}}}
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "positive_generation": {
      "type": "integer", "minimum": 1, "maximum": 9007199254740991
    }
  }
}
