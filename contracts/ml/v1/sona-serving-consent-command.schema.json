{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.local/contracts/ml/v1/sona-serving-consent-command.schema.json",
  "title": "Self-only Sona descendant-model serving consent command v1",
  "x-autplay-implementation-status": "CONTRACT_ONLY_DISABLED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_revision",
    "purpose",
    "decision",
    "step_up_challenge_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "purpose": {
      "const": "SONA_R1C_DESCENDANT_MODEL_SERVING_V1"
    },
    "decision": {
      "enum": ["GRANTED", "DENIED", "WITHDRAWN"]
    },
    "step_up_challenge_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "GRANTED"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"step_up_challenge_id": {"type": "string"}}
      },
      "else": {
        "properties": {"step_up_challenge_id": {"type": "null"}}
      }
    }
  ]
}
