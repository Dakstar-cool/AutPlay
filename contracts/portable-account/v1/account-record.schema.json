{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autplay.app/contracts/portable-account/v1/account-record.schema.json",
  "title": "Portable account metadata record v1 (implementation draft)",
  "description": "Personal metadata only. Never transfers credentials, passport envelopes, session/device authority, private origins, paths or Vault grants. Runtime also requires canonical UUID strings, integer JSON tokens, JCS document <=16384 bytes and LISTENING.record_id in event_ids; these cross-field/byte constraints cannot be expressed fully by standard JSON Schema. Genres/aliases are normalized by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "kind",
    "document"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "kind": {
      "enum": [
        "LISTENING",
        "PREFERENCE",
        "PLAYLIST",
        "PLAYLIST_ENTRY",
        "TASTE"
      ]
    },
    "document": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "LISTENING"
        },
        "document": {
          "$ref": "#/$defs/LISTENING"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "PREFERENCE"
        },
        "document": {
          "$ref": "#/$defs/PREFERENCE"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "PLAYLIST"
        },
        "document": {
          "$ref": "#/$defs/PLAYLIST"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "PLAYLIST_ENTRY"
        },
        "document": {
          "$ref": "#/$defs/PLAYLIST_ENTRY"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "TASTE"
        },
        "document": {
          "$ref": "#/$defs/TASTE"
        }
      }
    }
  ],
  "$defs": {
    "LISTENING": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "updated_at_ms",
        "event_ids",
        "track_key",
        "title",
        "artist",
        "genres",
        "started_at_ms",
        "played_ms",
        "duration_ms",
        "excluded_from_taste",
        "event_origin",
        "context"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          }
        },
        "track_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "artist": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "genres": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
          }
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "played_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800000
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_from_taste": {
          "type": "boolean"
        },
        "event_origin": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$(?![\\s\\S])"
        },
        "context": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,49}$(?![\\s\\S])"
        }
      }
    },
    "PREFERENCE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "updated_at_ms",
        "track_key",
        "title",
        "artist",
        "preference",
        "rating",
        "excluded_from_taste"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "track_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "artist": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "preference": {
          "enum": [
            "NEUTRAL",
            "LIKED",
            "DISLIKED"
          ]
        },
        "rating": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_from_taste": {
          "type": "boolean"
        }
      }
    },
    "PLAYLIST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "updated_at_ms",
        "name",
        "description",
        "deleted"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted": {
          "type": "boolean"
        }
      }
    },
    "PLAYLIST_ENTRY": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "updated_at_ms",
        "playlist_id",
        "track_key",
        "title",
        "artist",
        "position_key",
        "deleted"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "playlist_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "track_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "artist": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "position_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]+$(?![\\s\\S])"
        },
        "deleted": {
          "type": "boolean"
        }
      }
    },
    "TASTE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "updated_at_ms",
        "track_key",
        "interaction",
        "weight"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "track_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "interaction": {
          "enum": [
            "LIKE",
            "DISLIKE",
            "SKIP",
            "COMPLETE",
            "EXCLUDE"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    }
  }
}
