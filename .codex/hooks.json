{
  "description": "AutPlay verified phase-transition hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen autplay-phase-stop stop --manifest docs/implementation/AUTPLAY_CODEX_PHASE_PIPELINE.json",
            "commandWindows": "uv run --frozen autplay-phase-stop stop --manifest docs/implementation/AUTPLAY_CODEX_PHASE_PIPELINE.json",
            "timeout": 4200,
            "statusMessage": "Checking verified AutPlay phase transition"
          }
        ]
      }
    ]
  }
}
